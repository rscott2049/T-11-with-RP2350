  if (pio == pio0) return (uint32_t *)&pio0->rxf[sm];
  else if (pio == pio1) return (uint32_t *)&pio1->rxf[sm];
  else if (pio == pio2) return (uint32_t *)&pio2->rxf[sm];

  return 0;
}

